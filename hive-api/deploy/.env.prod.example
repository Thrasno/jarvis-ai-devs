# Copy this file to .env on the server and replace every value.
# Never commit the real .env file.

# PostgreSQL container settings.
POSTGRES_USER=hive
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=hivedb

# hive-api connects to the Compose postgres service by service name.
# URL-encode special password characters in DATABASE_URL, especially:
# @ : / ? # %
DATABASE_URL=postgres://hive:replace-with-a-long-random-password@postgres:5432/hivedb?sslmode=disable

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Host port exposed only on 127.0.0.1 by docker-compose.prod.yml.
PORT=8080

# Production should normally run in release mode.
GIN_MODE=release

# Comma-separated allowed browser origins. Keep the dashboard origin here.
CORS_ALLOWED_ORIGINS=https://hivemem.dev

# Enables the admin project quarantine/block UI routes used by the dashboard.
JARVIS_ENABLE_PROJECT_BLOCK_ADMIN=true

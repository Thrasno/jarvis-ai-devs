# Schema-v2 custom presentation profile.
# Copy this file and choose only renderer-owned pack IDs.
# Technical, educational, workflow, and tool policy belongs to the shared contract,
# not to persona profiles.

# Machine-readable identifier: lowercase letters, digits, and hyphens.
schema_version: 2
name: my-custom-persona
display_name: "My Custom Persona"
presentation:
  # language: es-rioplatense | es-neutral | es-asturian | es-galician | en-us
